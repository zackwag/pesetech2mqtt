# MQTT broker connection — required when not using the bundled Mosquitto broker.
# To use the bundled broker instead, start with: COMPOSE_PROFILES=mqtt docker compose up
MQTT_HOST=192.168.1.x
#MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=
#MQTT_SSL=false

# Host paths for volume mounts (defaults shown)
#PESETECH_DATA_DIR=./docker/config
#PESETECH_MESH_JSON=./docker/pesetech_mesh.json
